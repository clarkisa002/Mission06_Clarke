@using System.Runtime.Versioning
@model MovieSubmission

<h2 class="mb-4">Submit a Movie to Joel's Collection!</h2>

<form asp-action="SubmitMovie" method="post" class="row g-3">
    <div class="col-12">
        <div asp-validation-summary="All" class="text-danger"></div>
    </div>
    <div class="col-md-4">
        <label asp-for="CategoryId" class="form-label">Category</label>
        <select name="CategoryId" id="CategoryId" class="form-select" data-val="false">
            <option value="">Select a Category</option>
            @foreach (Category c in ViewBag.Categories)
            {
                <option value="@c.CategoryId">@c.CategoryName</option>
            }
        </select>
    </div>

    <div class="col-md-4">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control"/>
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Year" class="form-label"></label>
        <input asp-for="Year" class="form-control" type="number" min="1888" />
        <span asp-validation-for="Year" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Director" class="form-label"></label>
        <input asp-for="Director" class="form-control"/>
        <span asp-validation-for="Director" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Rating" class="form-label">Rating</label>
        <select asp-for="Rating" class="form-select">
            <option value="">Select Rating</option>
            <option value="G">G</option>
            <option value="PG">PG</option>
            <option value="PG-13">PG-13</option>
            <option value="R">R</option>
        </select>
        <span asp-validation-for="Rating" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Edited" class="form-label">Was the Movie Edited?</label>
        <select asp-for="Edited" class="form-select">
            <option value="true">Yes</option>
            <option value="false">No</option>
        </select>
        <span asp-validation-for="Edited" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="CopiedToPlex" class="form-label">Copied To Plex?</label>
        <select asp-for="CopiedToPlex" class="form-select">
            <option value="true">Yes</option>
            <option value="false">No</option>
        </select>
        <span asp-validation-for="CopiedToPlex" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="LentTo" class="form-label"></label>
        <input asp-for="LentTo" class="form-control"/>
        <span asp-validation-for="LentTo" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Notes" class="form-label"></label>
        <input asp-for="Notes" class="form-control" maxlength="25"/>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Submit Movie</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}